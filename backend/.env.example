# =================================================================
# PHANTOM RECON v2.1 — SERVER-SIDE ENVIRONMENT CONFIGURATION
# =================================================================
# These keys are NEVER exposed to the frontend bundle or client APIs.
# Store this file as .env in production (or set via hosting dashboard).

# --- Reconnaissance API Integrations (All Optional) ---
# Shodan: Exposed services, banners, and CVE correlation (https://account.shodan.io)
SHODAN_API_KEY=

# VirusTotal: Passive DNS and threat reputation lookup (https://www.virustotal.com)
VIRUSTOTAL_API_KEY=

# Hunter.io: Corporate email harvesting & syntax discovery (https://hunter.io)
HUNTER_API_KEY=

# Netlas.io: Subdomain discovery and historical DNS (https://netlas.io)
NETLAS_API_KEY=

# GitHub: Scans public code repositories for leaked secrets & tokens (https://github.com/settings/tokens)
GITHUB_TOKEN=

# Censys: Global attack surface search engine (https://search.censys.io)
CENSYS_API_ID=
CENSYS_API_SECRET=

# --- Server & Persistence Settings ---
PORT=8000
ALLOWED_ORIGINS=*
PHANTOM_DB_PATH=phantom.db
PHANTOM_OUTPUT_DIR=output
